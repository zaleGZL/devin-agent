{
  "name": "devin-coding-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop coding agent powered by Devin CLI",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @devin-agent/desktop dev",
    "typecheck": "pnpm --filter @devin-agent/desktop typecheck",
    "lint": "pnpm --filter @devin-agent/desktop lint",
    "test": "pnpm test:docs-sync && pnpm test:renderer-architecture && pnpm --filter @devin-agent/desktop test",
    "test:docs-sync": "node --test scripts/sync-devin-cli-docs.test.mjs",
    "test:renderer-architecture": "node --test scripts/check-renderer-architecture.test.mjs",
    "docs:sync:devin-cli": "node scripts/sync-devin-cli-docs.mjs",
    "build": "pnpm --filter @devin-agent/desktop build",
    "pack": "pnpm --filter @devin-agent/desktop run pack",
    "pack:mac": "node scripts/package-mac-arm64.mjs",
    "check": "pnpm check:renderer-architecture && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "check:renderer-architecture": "node scripts/check-renderer-architecture.mjs",
    "check:independence": "node scripts/check-independence.mjs",
    "publish:desktop": "node scripts/publish-desktop.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
