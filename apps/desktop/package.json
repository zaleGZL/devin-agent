{
  "name": "@devin-agent/desktop",
  "productName": "Devin Agent",
  "version": "0.1.25",
  "private": true,
  "description": "Native desktop client for Devin CLI",
  "homepage": "https://github.com/zaleGZL/devin-agent",
  "author": {
    "name": "Devin Agent contributors",
    "email": "zelingzale@gmail.com"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main/index.mjs",
  "scripts": {
    "dev": "pnpm build:electron && node scripts/dev.mjs",
    "build:electron": "node scripts/clean-electron-build.mjs && tsup",
    "build:renderer": "vite build",
    "build": "pnpm build:electron && pnpm build:renderer",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "pack": "pnpm build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir --config.mac.notarize=false",
    "dist": "pnpm build && electron-builder",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:linux": "pnpm build && electron-builder --linux",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "smoke:devin": "node scripts/live-cli-smoke.mjs",
    "start": "electron ."
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "lucide-react": "^1.31.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wait-on": "^9.1.0"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
